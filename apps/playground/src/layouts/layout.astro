---
import { ClientRouter } from "astro:transitions";

type Props = {
  title?: string;
};

const { title = "@tinloof/astro-prefetch playground" } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>{title}</title>
  </head>
  <body>
    <ClientRouter/>
    <slot/>

    <!-- Control panel: live-tunes the integration via configure(). Values
         persist in localStorage and re-apply after every navigation. -->
    <details class="pf-panel" open>
      <summary>⚙ prefetch controls</summary>
      <div class="pf-controls">
        <label class="pf-row">
          <span>strategy</span>
          <select data-pf="defaultStrategy">
            <option value="proximity">proximity</option>
            <option value="hover">hover</option>
            <option value="viewport">viewport</option>
            <option value="tap">tap</option>
            <option value="load">load</option>
          </select>
        </label>
        <label class="pf-row pf-check">
          <input type="checkbox" data-pf="proximityEnabled">
          <span>proximity predictor</span>
        </label>
        <label class="pf-row">
          <span
            >lookahead <output data-pf-out="lookaheadMs">150</output>ms</span
          >
          <input type="range" min="0" max="500" step="10" data-pf="lookaheadMs">
        </label>
        <label class="pf-row">
          <span
            >radius <output data-pf-out="radiusPx">64</output>px</span
          >
          <input type="range" min="0" max="200" step="4" data-pf="radiusPx">
        </label>
        <label class="pf-row">
          <span
            >min speed <output data-pf-out="minSpeedPxS">80</output>px/s</span
          >
          <input type="range" min="0" max="500" step="10" data-pf="minSpeedPxS">
        </label>
        <label class="pf-row">
          <span
            >max speed <output data-pf-out="maxSpeedPxS">2500</output>px/s</span
          >
          <input
            type="range"
            min="500"
            max="6000"
            step="100"
            data-pf="maxSpeedPxS"
          >
        </label>
        <label class="pf-row">
          <span
            >stale time <output data-pf-out="staleTimeMs">30</output>s</span
          >
          <input
            type="range"
            min="5000"
            max="120000"
            step="5000"
            data-pf="staleTimeMs"
          >
        </label>
        <label class="pf-row pf-check">
          <input type="checkbox" data-pf="badge">
          <span>debug badge</span>
        </label>
        <label class="pf-row pf-check">
          <input type="checkbox" data-pf="overlay">
          <span>debug overlay</span>
        </label>
        <div class="pf-actions">
          <button type="button" data-pf-action="clear">clear cache</button>
          <button type="button" data-pf-action="reset">reset defaults</button>
        </div>
        <p class="pf-note">
          Runtime is inert in <code>astro dev</code>— use
          <code>pnpm preview</code>.
        </p>
      </div>
    </details>

    <script>
      import { configure, invalidate } from "@tinloof/astro-prefetch/client";

      const STORAGE_KEY = "playground-prefetch";

      type PanelState = {
        defaultStrategy: "tap" | "hover" | "viewport" | "load" | "proximity";
        proximityEnabled: boolean;
        lookaheadMs: number;
        radiusPx: number;
        minSpeedPxS: number;
        maxSpeedPxS: number;
        staleTimeMs: number;
        badge: boolean;
        overlay: boolean;
      };

      const DEFAULTS: PanelState = {
        defaultStrategy: "proximity",
        proximityEnabled: true,
        lookaheadMs: 150,
        radiusPx: 64,
        minSpeedPxS: 80,
        maxSpeedPxS: 2500,
        staleTimeMs: 30_000,
        badge: true,
        overlay: true,
      };

      function load(): PanelState {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          return { ...DEFAULTS, ...(raw ? JSON.parse(raw) : {}) };
        } catch {
          return { ...DEFAULTS };
        }
      }

      function save(state: PanelState): void {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }

      function apply(state: PanelState): void {
        configure({
          defaultStrategy: state.defaultStrategy,
          staleTimeMs: state.staleTimeMs,
          proximity: state.proximityEnabled
            ? {
                lookaheadMs: state.lookaheadMs,
                radiusPx: state.radiusPx,
                minSpeedPxS: state.minSpeedPxS,
                maxSpeedPxS: state.maxSpeedPxS,
              }
            : false,
          debug: { badge: state.badge, overlay: state.overlay },
        });
      }

      // The panel is server-rendered into every page (the body is replaced
      // on each swap), so the UI must be re-synced after every navigation.
      function syncUI(state: PanelState): void {
        for (const el of document.querySelectorAll<
          HTMLInputElement | HTMLSelectElement
        >("[data-pf]")) {
          const key = el.dataset.pf as keyof PanelState;
          const value = state[key];
          if (el instanceof HTMLInputElement && el.type === "checkbox") {
            el.checked = Boolean(value);
          } else {
            el.value = String(value);
          }
        }
        for (const out of document.querySelectorAll<HTMLOutputElement>(
          "[data-pf-out]"
        )) {
          const key = out.dataset.pfOut as keyof PanelState;
          const value = state[key] as number;
          out.textContent = String(
            key === "staleTimeMs" ? value / 1000 : value
          );
        }
      }

      // Delegated listeners survive swaps; this module runs once per load.
      document.addEventListener("input", (e) => {
        const el = e.target as HTMLInputElement | HTMLSelectElement;
        const key = el.dataset?.pf as keyof PanelState | undefined;
        if (!key) {
          return;
        }
        const state = load();
        if (el instanceof HTMLInputElement && el.type === "checkbox") {
          (state[key] as boolean) = el.checked;
        } else if (el instanceof HTMLInputElement && el.type === "range") {
          (state[key] as number) = Number(el.value);
        } else {
          (state[key] as PanelState["defaultStrategy"]) =
            el.value as PanelState["defaultStrategy"];
        }
        save(state);
        syncUI(state);
        apply(state);
      });

      document.addEventListener("click", (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>(
          "[data-pf-action]"
        );
        if (!button) {
          return;
        }
        if (button.dataset.pfAction === "clear") {
          invalidate();
          button.textContent = "cleared ✓";
          setTimeout(() => {
            button.textContent = "clear cache";
          }, 1000);
        }
        if (button.dataset.pfAction === "reset") {
          save({ ...DEFAULTS });
          syncUI(DEFAULTS);
          apply(DEFAULTS);
        }
      });

      const boot = () => {
        const state = load();
        syncUI(state);
        apply(state);
      };
      boot();
      document.addEventListener("astro:page-load", boot);
    </script>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    color: #172033;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    min-height: 100vh;
    padding: 2.5rem 2rem 8rem;
    background:
      radial-gradient(
        circle at top left,
        rgba(99, 102, 241, 0.16),
        transparent 30rem
      ), linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
  }

  main {
    max-width: 60rem;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #4f46e5;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.05;
  }

  p {
    color: #475569;
    line-height: 1.65;
  }

  .meta-card {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    margin: 1rem 0 2rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgba(79, 70, 229, 0.16);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.85);
    font:
      600 0.85rem / 1.4 ui-monospace,
      Menlo,
      monospace;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: block;
    padding: 1.25rem;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.88);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
  }

  .card .emoji {
    font-size: 1.8rem;
  }

  .card h2 {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    font-size: 0.85rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    margin-top: 1.5rem;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    background: #4f46e5;
    color: white;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 12px 30px rgba(79, 70, 229, 0.28);
  }

  /* ------- control panel ------- */
  .pf-panel {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 9999;
    width: 17rem;
    border: 1px solid rgba(148, 163, 184, 0.4);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 16px 50px rgba(15, 23, 42, 0.18);
    font-size: 0.8rem;
  }

  .pf-panel summary {
    padding: 0.65rem 0.9rem;
    cursor: pointer;
    font-weight: 700;
    user-select: none;
  }

  .pf-controls {
    display: grid;
    gap: 0.55rem;
    padding: 0 0.9rem 0.9rem;
  }

  .pf-row {
    display: grid;
    gap: 0.25rem;
  }

  .pf-row span {
    color: #334155;
    font-weight: 600;
  }

  .pf-row output {
    color: #4f46e5;
  }

  .pf-check {
    grid-template-columns: auto 1fr;
    align-items: center;
  }

  .pf-row select {
    padding: 0.3rem 0.4rem;
    border: 1px solid rgba(148, 163, 184, 0.5);
    border-radius: 0.5rem;
    background: white;
    font: inherit;
  }

  .pf-row input[type="range"] {
    width: 100%;
  }

  .pf-actions {
    display: flex;
    gap: 0.5rem;
  }

  .pf-actions button {
    flex: 1;
    padding: 0.45rem 0;
    border: 1px solid rgba(79, 70, 229, 0.35);
    border-radius: 0.5rem;
    background: #eef2ff;
    color: #3730a3;
    font: 600 0.75rem / 1 inherit;
    cursor: pointer;
  }

  .pf-actions button:hover {
    background: #e0e7ff;
  }

  .pf-note {
    margin: 0;
    color: #64748b;
    font-size: 0.7rem;
  }

  .pf-note code {
    font-family: ui-monospace, Menlo, monospace;
  }
</style>
