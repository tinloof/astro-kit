---
import { ClientRouter } from "astro:transitions";

type Props = {
  title?: string;
};

const { title = "@tinloof/astro-prefetch playground" } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Mono&display=swap"
      rel="stylesheet"
    >
    <title>{title}</title>
  </head>
  <body>
    <ClientRouter />
    <slot />

    <!-- Control panel: live-tunes the integration via configure(). Values
         persist in localStorage and re-apply after every navigation. -->
    <details class="pf-panel" open>
      <summary>Prefetch controls</summary>
      <div class="pf-controls">
        <label class="pf-row">
          <span>Strategy</span>
          <select data-pf="defaultStrategy">
            <option value="proximity">proximity</option>
            <option value="hover">hover</option>
            <option value="viewport">viewport</option>
            <option value="tap">tap</option>
            <option value="load">load</option>
          </select>
        </label>
        <label class="pf-row pf-check">
          <input type="checkbox" data-pf="proximityEnabled">
          <span>Proximity predictor</span>
        </label>
        <label class="pf-row">
          <span>Lookahead <output data-pf-out="lookaheadMs">150</output>ms</span>
          <input type="range" min="0" max="500" step="10" data-pf="lookaheadMs">
        </label>
        <label class="pf-row">
          <span>Radius <output data-pf-out="radiusPx">64</output>px</span>
          <input type="range" min="0" max="200" step="4" data-pf="radiusPx">
        </label>
        <label class="pf-row">
          <span>Min speed <output data-pf-out="minSpeedPxS">80</output>px/s</span>
          <input type="range" min="0" max="500" step="10" data-pf="minSpeedPxS">
        </label>
        <label class="pf-row">
          <span>Max speed <output data-pf-out="maxSpeedPxS">2500</output>px/s</span>
          <input type="range" min="500" max="6000" step="100" data-pf="maxSpeedPxS">
        </label>
        <label class="pf-row">
          <span>Stale time <output data-pf-out="staleTimeMs">30</output>s</span>
          <input type="range" min="5000" max="120000" step="5000" data-pf="staleTimeMs">
        </label>
        <label class="pf-row pf-check">
          <input type="checkbox" data-pf="badge">
          <span>Debug badge</span>
        </label>
        <label class="pf-row pf-check">
          <input type="checkbox" data-pf="overlay">
          <span>Debug overlay</span>
        </label>
        <div class="pf-actions">
          <button type="button" data-pf-action="clear">Clear cache</button>
          <button type="button" data-pf-action="reset">Reset</button>
        </div>
        <p class="pf-note">
          Runtime is inert in <code>astro dev</code> — use
          <code>pnpm preview</code>.
        </p>
      </div>
    </details>

    <script>
      import { configure, invalidate } from "@tinloof/astro-prefetch/client";

      const STORAGE_KEY = "playground-prefetch";

      type PanelState = {
        defaultStrategy: "tap" | "hover" | "viewport" | "load" | "proximity";
        proximityEnabled: boolean;
        lookaheadMs: number;
        radiusPx: number;
        minSpeedPxS: number;
        maxSpeedPxS: number;
        staleTimeMs: number;
        badge: boolean;
        overlay: boolean;
      };

      const DEFAULTS: PanelState = {
        defaultStrategy: "proximity",
        proximityEnabled: true,
        lookaheadMs: 150,
        radiusPx: 64,
        minSpeedPxS: 80,
        maxSpeedPxS: 2500,
        staleTimeMs: 30_000,
        badge: true,
        overlay: true,
      };

      function load(): PanelState {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          return { ...DEFAULTS, ...(raw ? JSON.parse(raw) : {}) };
        } catch {
          return { ...DEFAULTS };
        }
      }

      function save(state: PanelState): void {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }

      function apply(state: PanelState): void {
        configure({
          defaultStrategy: state.defaultStrategy,
          staleTimeMs: state.staleTimeMs,
          proximity: state.proximityEnabled
            ? {
                lookaheadMs: state.lookaheadMs,
                radiusPx: state.radiusPx,
                minSpeedPxS: state.minSpeedPxS,
                maxSpeedPxS: state.maxSpeedPxS,
              }
            : false,
          debug: { badge: state.badge, overlay: state.overlay },
        });
      }

      // The panel is server-rendered into every page (the body is replaced
      // on each swap), so the UI must be re-synced after every navigation.
      function syncUI(state: PanelState): void {
        for (const el of document.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-pf]")) {
          const key = el.dataset.pf as keyof PanelState;
          const value = state[key];
          if (el instanceof HTMLInputElement && el.type === "checkbox") {
            el.checked = Boolean(value);
          } else {
            el.value = String(value);
          }
        }
        for (const out of document.querySelectorAll<HTMLOutputElement>("[data-pf-out]")) {
          const key = out.dataset.pfOut as keyof PanelState;
          const value = state[key] as number;
          out.textContent = String(key === "staleTimeMs" ? value / 1000 : value);
        }
      }

      // Delegated listeners survive swaps; this module runs once per load.
      document.addEventListener("input", (e) => {
        const el = e.target as HTMLInputElement | HTMLSelectElement;
        const key = el.dataset?.pf as keyof PanelState | undefined;
        if (!key) {
          return;
        }
        const state = load();
        if (el instanceof HTMLInputElement && el.type === "checkbox") {
          (state[key] as boolean) = el.checked;
        } else if (el instanceof HTMLInputElement && el.type === "range") {
          (state[key] as number) = Number(el.value);
        } else {
          (state[key] as PanelState["defaultStrategy"]) =
            el.value as PanelState["defaultStrategy"];
        }
        save(state);
        syncUI(state);
        apply(state);
      });

      document.addEventListener("click", (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>("[data-pf-action]");
        if (!button) {
          return;
        }
        if (button.dataset.pfAction === "clear") {
          invalidate();
          button.textContent = "Cleared ✓";
          setTimeout(() => {
            button.textContent = "Clear cache";
          }, 1000);
        }
        if (button.dataset.pfAction === "reset") {
          save({ ...DEFAULTS });
          syncUI(DEFAULTS);
          apply(DEFAULTS);
        }
      });

      const boot = () => {
        const state = load();
        syncUI(state);
        apply(state);
      };
      boot();
      document.addEventListener("astro:page-load", boot);
    </script>
  </body>
</html>

<style is:global>
  /* Design tokens mirrored from ttfb-test (shadcn new-york, neutral). */
  :root {
    --background: oklch(1 0 0);
    --foreground: oklch(0.145 0 0);
    --card: oklch(1 0 0);
    --muted: oklch(0.97 0 0);
    --muted-foreground: oklch(0.556 0 0);
    --border: oklch(0.922 0 0);
    --primary: oklch(0.205 0 0);
    --primary-foreground: oklch(0.985 0 0);
    --ring: oklch(0.708 0 0);
    --destructive: oklch(0.577 0.245 27.325);
    --radius: 0.375rem;
    --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  * {
    box-sizing: border-box;
    border-color: var(--border);
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    min-height: 100vh;
    padding: 2.5rem 1.5rem 9rem;
    background: oklch(0.97 0 0); /* neutral-100 */
    color: var(--foreground);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  button,
  a {
    cursor: pointer;
  }

  main {
    max-width: 56rem;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--muted-foreground);
    max-width: 44rem;
  }

  h2 {
    margin: 2rem 0 0.75rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .meta-card {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin: 1.25rem 0 1.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;
  }

  .card {
    display: block;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: inherit;
    text-decoration: none;
    transition: border-color 140ms ease;
  }

  .card:hover {
    border-color: var(--foreground);
  }

  .card .emoji {
    font-size: 1.4rem;
  }

  .card h2 {
    margin: 0.5rem 0 0.15rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .card p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 12px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    margin-top: 1.75rem;
    padding: 0 1rem;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 140ms ease;
  }

  .button:hover {
    opacity: 0.9;
  }

  /* ------- control panel ------- */
  .pf-panel {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 9999;
    width: 16.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 0 1px 2px oklch(0 0 0 / 5%);
    font-size: 12px;
  }

  .pf-panel summary {
    padding: 0.6rem 0.8rem;
    cursor: pointer;
    font-weight: 600;
    user-select: none;
  }

  .pf-panel[open] summary {
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.65rem;
  }

  .pf-controls {
    display: grid;
    gap: 0.55rem;
    padding: 0 0.8rem 0.8rem;
  }

  .pf-row {
    display: grid;
    gap: 0.3rem;
  }

  .pf-row span {
    color: var(--foreground);
    font-weight: 500;
  }

  .pf-row output {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .pf-check {
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.5rem;
  }

  .pf-check input {
    accent-color: var(--primary);
  }

  .pf-row select {
    padding: 0.35rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
  }

  .pf-row input[type="range"] {
    width: 100%;
    accent-color: var(--primary);
  }

  .pf-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.2rem;
  }

  .pf-actions button {
    flex: 1;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--foreground);
    font: 500 12px/1 var(--font-sans);
    transition: background 140ms ease;
  }

  .pf-actions button:hover {
    background: var(--muted);
  }

  .pf-note {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 11px;
  }

  .pf-note code {
    font-family: var(--font-mono);
    font-size: 10px;
  }
</style>
