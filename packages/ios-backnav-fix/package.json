{
  "name": "@tinloof/astro-ios-backnav-fix",
  "version": "0.1.0",
  "description": "Astro integration that fixes the back button in iOS Chrome/Edge when using the ClientRouter for view transitions.",
  "license": "MIT",
  "author": "Tinloof (https://tinloof.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinloof/astro-kit.git",
    "directory": "packages/ios-backnav-fix"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
